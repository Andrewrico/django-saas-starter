# Copy to .env (make setup does this). Never commit .env.
DEBUG=true
# Required when DEBUG=false. Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
# postgres example: postgres://saas:saas@localhost:5432/saas

# Auth: none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=optional

# Optional authenticator enrolment (existing MFA is always enforced).
MFA_ENROLLMENT_ENABLED=false

# Private project attachments (docs/uploads.md).
UPLOADS_ENABLED=false
UPLOAD_MAX_FILE_BYTES=5242880
# Empty uses local media/; Cloud Run uses its service account for a private bucket.
GS_BUCKET_NAME=

# Email (console by default; use SMTP or an anymail backend in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Django SaaS Starter <noreply@example.com>
SITE_NAME=Django SaaS Starter

# Behind a TLS-terminating proxy (Cloud Run, Fly, ...) set true
TRUST_PROXY_SSL_HEADER=false

# Social sign-in: each provider is OFF until both its values are set (docs/auth.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SQLite backups with Litestream (Docker image only; docs/deployment.md). Empty = off.
# e.g. gs://my-bucket/db, s3://my-bucket/db, file:///backups/db
LITESTREAM_REPLICA_URL=

# Scheduled jobs HTTP trigger (POST /internal/jobs/run/). Off when all are empty.
# Cloud Scheduler (the deploy script sets these): JOBS_OIDC_AUDIENCE, JOBS_INVOKER_EMAIL
# Any other scheduler: a random bearer token of 32+ characters
JOBS_TRIGGER_TOKEN=

# Billing is OFF unless all three are set
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Plausible analytics (OFF when empty). Public pages load the script for this domain.
# PLAUSIBLE_DOMAIN=example.com
